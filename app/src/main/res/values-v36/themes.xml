<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme for SDK 36 and above. -->
    <style name="Theme.DinnerHalp" parent="Theme.Material3.DayNight">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSecondary">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorKnockout</item>
        <item name="colorOnSecondary">@color/colorKnockout</item>
        <item name="actionBarTheme">@style/ThemeOverlay.DinnerHalp.ActionBar</item>
        <item name="android:actionMenuTextColor">@color/colorPrimaryDark</item>
        <!--  FAB color and text      -->
        <item name="colorPrimaryContainer">@color/colorPrimaryDark</item>
        <item name="colorOnPrimaryContainer">@color/colorKnockout</item>

        <!-- Preferences dialogs use alertDialogTheme; all others use materialAlertDialogTheme-->
        <item name="alertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
        <item name="materialCalendarTheme">@style/ThemeOverlay.App.DatePicker</item>
        <!--  Keep content from overlapping device cutout  -->
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
    </style>

    <!-- Custom theme for action bar -->
    <style name="ThemeOverlay.DinnerHalp.ActionBar" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/colorPrimaryDark</item>
    </style>

    <!-- Custom theme for DinnerListActivity; is called in AndroidManifest -->
    <style name="Theme.DinnerHalp.DinnerListActivity" parent="Theme.DinnerHalp">
        <item name="android:actionModeBackground">@color/colorPrimaryDark</item>
        <item name="android:colorControlActivated">@color/colorLongPressSelected</item>
        <!-- Color at bottom of action bar during CAB mode -->
        <item name="android:colorLongPressedHighlight">@color/colorPrimaryDark</item>
    </style>

    <style name="HeaderText">
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:clickable">false</item>
    </style>

    <style name="ListText">
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">@color/colorDefaultText</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="DinnerListText">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/colorDefaultText</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="DinnerDateText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorDefaultText</item>
        <!--item name="android:paddingTop">8dp</item-->
    </style>

    <style name="HintText">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/colorHintText</item>
    </style>

    <style name="SmallButton">
        <!--        <item name="android:background">@color/colorPrimaryDark</item>-->
        <item name="android:padding">4dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorKnockout</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="HelpButton">
        <!--        <item name="android:background">@color/colorPrimaryDark</item>-->
        <item name="android:padding">6dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/colorKnockout</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="ViewDinnerText">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/colorDefaultText</item>
    </style>

    <style name="ViewDinnerRecipeText" parent="ViewDinnerText">
        <item name="android:textSize">16sp</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="TextAppearance.Custom.DialogButton" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <!-- Don't think this style is used anymore   -->
    <style name="Theme.DinnerHalp.CustomAlertDialog" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="android:borderlessButtonStyle">@style/Widget.Custom.Button.Borderless</item>
        <item name="colorPrimary">@color/colorPrimary</item>
    </style>

    <style name="Theme.DinnerHalp.CustomTabLayout" parent="Widget.Design.TabLayout">
<!--        <item name="tabBackground">@color/colorPrimaryDark</item>-->
        <item name="dividerColor">@color/colorUnselectedText</item>
        <item name="tabIndicator">@color/colorAccent</item>
        <item name="tabIndicatorColor">@color/colorAccent</item>
        <item name="tabTextAppearance">@style/TextAppearance.Design.Tab</item>
        <!--   colorOnSurface controls unselected tab text -->
        <item name="colorOnSurface">@color/colorUnselectedText</item>
    </style>

    <style name="ThemeOverlay.App.DatePicker" parent="@style/ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/colorPrimaryDark</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Custom.Button.Borderless</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Custom.Button.Borderless</item>
    </style>

    <!-- Custom button style targeting text appearance -->
    <style name="Widget.Custom.Button.Borderless" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.Custom.DialogButton</item>
    </style>

    <!-- Override Material3 alert dialog defaults -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- Button text styling -->
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Custom.Button.Borderless</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Custom.Button.Borderless</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Custom.Button.Borderless</item>
        <item name="colorSurfaceContainerHigh">@color/colorKnockout</item>
        <!-- Round alertDialog corners used in Settings to match Material3 -->
        <item name="dialogCornerRadius">28dp</item>
    </style>

</resources>
