<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
<!-- Base application theme for SDK 36 and up, night mode. -->
<style name="Theme.DinnerHalp" parent="Theme.Material3.DayNight">
    <!-- Primary brand color. -->
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
    <item name="colorOnPrimary">@color/colorKnockout</item>
    <item name="android:colorBackground">@color/colorBackground</item>
    <!-- Secondary brand color. -->
    <item name="colorSecondary">@color/colorPrimaryDark</item>
    <item name="colorOnSecondary">@color/colorKnockout</item>

    <!-- Customize your theme here. -->
    <!-- Status bar color. -->
    <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    <item name="actionBarTheme">@style/ThemeOverlay.DinnerHalp.ActionBar</item>
    <!-- Preferences dialogs use alertDialogTheme -->
    <item name="alertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
    <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
    <item name="materialCalendarTheme">@style/ThemeOverlay.App.NightDatePicker</item>
    <!--  FAB color and text      -->
    <item name="colorPrimaryContainer">@color/colorPrimaryDark</item>
    <item name="colorOnPrimaryContainer">@color/colorKnockout</item>
    <!-- Color for active toggles and edit text fields everywhere but DinnerListActivity -->
    <item name="android:colorControlActivated">@color/colorDefaultText</item>
</style>

<!-- Custom theme for action bar -->
<style name="ThemeOverlay.DinnerHalp.ActionBar" parent="Theme.Material3.DayNight">
    <item name="colorPrimary">@color/colorBackground</item>
</style>

<!-- Specific theme for DinnerListActivity to handle long press selected color -->
<style name="Theme.DinnerHalp.DinnerListActivity" parent="Theme.DinnerHalp">
    <item name="android:actionModeBackground">@color/colorPrimaryDark</item>
    <item name="android:colorControlActivated">@color/colorLongPressSelected</item>
    <!-- Color at bottom of action bar during CAB mode -->
    <item name="android:colorLongPressedHighlight">@color/colorPrimaryDark</item>
</style>

<!-- Not sure whether this theme is being used anywhere; it was in day mode themes -->
<style name="Theme.DinnerHalp.CustomTabLayout" parent="Widget.Design.TabLayout">
    <item name="tabBackground">@color/colorBackground</item>
    <item name="dividerColor">@color/colorUnselectedText</item>
    <item name="tabIndicator">@color/colorKnockout</item>
    <item name="tabIndicatorColor">@color/colorKnockout</item>
    <item name="tabSelectedTextColor">@color/colorKnockout</item>
    <item name="tabTextColor">@color/colorUnselectedText</item>
    <!--        Note that in the light theme, the unselected tab text uses colorOnSurface
                but tabTextColor still seems to work here -->
</style>

<style name="ThemeOverlay.App.NightDatePicker" parent="@style/ThemeOverlay.Material3.MaterialCalendar">
    <item name="colorPrimary">@color/colorDefaultText</item>
    <item name="colorOnPrimary">@color/colorBackground</item>
    <item name="buttonBarPositiveButtonStyle">@style/Widget.Custom.Button.Borderless</item>
    <item name="buttonBarNegativeButtonStyle">@style/Widget.Custom.Button.Borderless</item>
</style>

<style name="TextAppearance.Custom.DialogButton" parent="TextAppearance.Material3.LabelLarge">
    <item name="android:textAllCaps">true</item>
</style>

<style name="Widget.Custom.Button.Borderless" parent="Widget.Material3.Button.TextButton">
    <item name="android:textAppearance">@style/TextAppearance.Custom.DialogButton</item>
</style>

    <!-- Override Material3 alert dialog defaults -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- colorPrimary controls button text color -->
        <item name="colorPrimary">@color/colorDefaultText</item>
        <!-- colorAccent controls active radio button -->
        <item name="colorAccent">@color/colorDefaultText</item>
        <!-- Button text styling -->
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Custom.Button.Borderless</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Custom.Button.Borderless</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Custom.Button.Borderless</item>
        <!-- Round alertDialog corners used in Settings to match Material3 -->
        <item name="dialogCornerRadius">28dp</item>
    </style>

<style name="HeaderText">
    <item name="android:textSize">25sp</item>
    <item name="android:textColor">@color/colorDefaultText</item>
    <item name="android:textIsSelectable">true</item>
    <item name="android:clickable">false</item>
</style>

<style name="HelpButton">
    <item name="android:background">@color/colorPrimary</item>
    <item name="android:padding">6dp</item>
    <item name="android:textSize">18sp</item>
    <item name="android:textColor">@color/colorDefaultText</item>
    <item name="android:textAllCaps">true</item>
</style>

<style name="SmallButton">
    <item name="android:background">@color/colorPrimary</item>
    <item name="android:padding">4dp</item>
    <item name="android:textSize">14sp</item>
    <item name="android:textColor">@color/colorKnockout</item>
    <item name="android:gravity">center</item>
    <item name="android:textAllCaps">true</item>
</style>
</resources>